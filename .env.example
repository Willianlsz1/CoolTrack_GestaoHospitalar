# Copie este arquivo para .env.local e preencha com os valores reais.
# (.env.local é ignorado pelo git — nunca comite suas chaves.)

# Supabase (painel do projeto > Project Settings > API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-publica-aqui

# URL base usada nos QR Codes. Em produção, aponte para o domínio
# publicado (ex.: https://cooltrack-gestaohospitalar.pages.dev) para o
# QR funcionar ao ser lido pelo celular. Se vazia, o app usa a origem
# atual (window.location.origin) — útil em desenvolvimento.
VITE_APP_BASE_URL=https://cooltrack-gestaohospitalar.pages.dev
